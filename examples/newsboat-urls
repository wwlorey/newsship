# Newsboat URLs Example for Newsship
# Copy this to ~/.newsboat/urls

# ============================================
# Traditional RSS Feeds
# ============================================

https://news.ycombinator.com/rss "tech" "~Hacker News"
https://lobste.rs/rss "tech" "~Lobsters"
https://www.reddit.com/r/programming/.rss "tech" "~Reddit Programming"

# ============================================
# AI-Generated Feeds (via Newsship)
# ============================================
# Note: Update the path to your newsship binary
# These will be cached based on your refresh settings in ~/.newsship/feeds.conf

exec:~/.newsship/newsship tech-news "tech" "~AI: Tech News"
exec:~/.newsship/newsship security-news "security" "~AI: Security"
exec:~/.newsship/newsship ai-research "ai" "~AI: Research"

# ============================================
# Cost Management Tips
# ============================================
# 1. Set long cache TTLs in ~/.newsship/feeds.conf (e.g., refresh 86400 for 24 hours)
# 2. Disable auto-reload in ~/.newsboat/config (auto-reload no)
# 3. Only press 'r' to reload when you actually want fresh content
# 4. AI feeds will use cached results until the cache expires
