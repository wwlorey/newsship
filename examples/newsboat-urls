# Newsboat URLs Example for Natty Lang Feeder
# Copy this to ~/.newsboat/urls

# ============================================
# Traditional RSS Feeds
# ============================================

https://news.ycombinator.com/rss "tech" "~Hacker News"
https://lobste.rs/rss "tech" "~Lobsters"
https://www.reddit.com/r/programming/.rss "tech" "~Reddit Programming"

# ============================================
# AI-Generated Feeds (via Natty Lang Feeder)
# ============================================
# IMPORTANT: Use the wrapper script (natty-lang-feeder-wrapper.sh), not the binary directly.
# Newsboat's exec: requires shell scripts with shebangs, which the wrapper provides.
# These will be cached based on your refresh settings in ~/.natty-lang-feeder/feeds.conf

exec:~/.natty-lang-feeder/natty-lang-feeder-wrapper.sh tech-news "tech" "~AI: Tech News"
exec:~/.natty-lang-feeder/natty-lang-feeder-wrapper.sh security-news "security" "~AI: Security"
exec:~/.natty-lang-feeder/natty-lang-feeder-wrapper.sh ai-research "ai" "~AI: Research"

# ============================================
# How Day-Based Caching Works
# ============================================
# Natty Lang Feeder automatically caches AI articles for the entire calendar day (UTC)
#
# Example timeline:
# - Monday 8am: Open newsboat → AI generates articles (5 API calls for 5 feeds)
# - Monday 2pm: Reopen newsboat → Uses cache (0 API calls)
# - Monday 11pm: Reopen newsboat → Still Monday, uses cache (0 API calls)
# - Tuesday 7am: Open newsboat → New day, AI generates fresh articles (5 API calls)
#
# Cost Management:
# 1. Ensure auto-reload is disabled in ~/.newsboat/config
# 2. Articles automatically regenerate once per day when you open newsboat
# 3. No need to configure refresh intervals in feeds.conf
# 4. Use --force-refresh only when you need fresh articles during the same day
